generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  PLANNING
  AT_RISK
  ON_HOLD
}

enum BoqUnit {
  ITEM
  M
  M2
  M3
  KG
  TONNE
  LITRE
  DAY
  HOUR
  LS
}

enum BoqItemStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum ProcurementRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id        String  @id @default(cuid())
  name      String
  email     String  @unique
  avatarUrl String?
  image     String?

  emailVerified Boolean @default(false)

  memberships Membership[]
  accounts    Account[]
  sessions    Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Organization {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  location    String?

  memberships Membership[]
  projects    Project[]
  suppliers   Supplier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Project {
  id             String @id @default(cuid())
  organizationId String

  name        String
  slug        String
  description String?
  client      String?
  location    String?

  status   ProjectStatus @default(PLANNING)
  budget   Decimal       @db.Decimal(18, 2)
  progress Int           @default(0)

  startDate DateTime?
  endDate   DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  boq                 Boq?
  procurementRequests ProcurementRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, status])
}

model Boq {
  id        String @id @default(cuid())
  projectId String @unique

  name        String
  description String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sections BoqSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BoqSection {
  id    String @id @default(cuid())
  boqId String

  name        String
  description String?
  sortOrder   Int     @default(0)

  boq   Boq       @relation(fields: [boqId], references: [id], onDelete: Cascade)
  items BoqItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boqId])
  @@index([boqId, sortOrder])
}

model BoqItem {
  id        String @id @default(cuid())
  sectionId String

  itemCode    String
  description String
  unit        BoqUnit
  quantity    Decimal @db.Decimal(18, 4)
  rate        Decimal @db.Decimal(18, 2)

  status    BoqItemStatus @default(ACTIVE)
  sortOrder Int           @default(0)

  section BoqSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  procurementRequestItems ProcurementRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, itemCode])
  @@index([sectionId])
  @@index([sectionId, sortOrder])
}

model Supplier {
  id             String @id @default(cuid())
  organizationId String

  name    String
  contact String?
  email   String?
  phone   String?
  address String?
  status  SupplierStatus @default(ACTIVE)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  procurementRequests ProcurementRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, status])
}

model ProcurementRequest {
  id          String  @id @default(cuid())
  projectId   String
  supplierId  String?
  requestedBy String

  reference   String
  description String?
  status      ProcurementRequestStatus @default(DRAFT)

  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier     Supplier?                @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  requestItems ProcurementRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, reference])
  @@index([projectId])
  @@index([projectId, status])
  @@index([supplierId])
  @@index([requestedBy])
}

model ProcurementRequestItem {
  id                   String @id @default(cuid())
  procurementRequestId String
  boqItemId            String

  quantity Decimal @db.Decimal(18, 4)
  notes    String?

  procurementRequest ProcurementRequest @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  boqItem            BoqItem            @relation(fields: [boqItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([procurementRequestId, boqItemId])
  @@index([procurementRequestId])
  @@index([boqItemId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}
